# Database
DATABASE_URL="your-postgresql-database-url"

# Server
PORT=3003
NODE_ENV=development
FRONTEND_URL=http://localhost:3002

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRATION=7d

# ===================================================================
# REAL API CREDENTIALS - REQUIRED FOR REAL INTEGRATIONS
# ===================================================================
#
# To get REAL data (not dummy data), you need to create developer apps:
#
# 1. Instagram/Facebook: https://developers.facebook.com/apps/
# 2. WhatsApp Business: https://developers.facebook.com/docs/whatsapp
# 3. TikTok For Business: https://developers.tiktok.com/apps/
# 4. Stripe (payments): https://dashboard.stripe.com/apikeys
#
# ===================================================================

# Instagram Graph API (via Meta/Facebook)
# Tutorial: https://developers.facebook.com/docs/instagram-api/getting-started
META_APP_ID=your-meta-app-id-here
META_APP_SECRET=your-meta-app-secret-here
META_WEBHOOK_VERIFY_TOKEN=your-random-verify-token
META_REDIRECT_URI=http://localhost:3003/api/v1/integrations/instagram/callback

# Facebook Messenger API
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_VERIFY_TOKEN=your-random-verify-token
FACEBOOK_REDIRECT_URI=http://localhost:3003/api/v1/integrations/facebook/callback

# WhatsApp Business API
# Tutorial: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-permanent-token
WHATSAPP_VERIFY_TOKEN=your-random-verify-token

# TikTok For Business
# Tutorial: https://developers.tiktok.com/doc/login-kit-web
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:3003/api/v1/integrations/tiktok/callback

# Stripe for Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Optional: Redis for caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
